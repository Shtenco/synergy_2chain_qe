# Perpetual Arbitrage Engine - Environment Configuration
# Copy this file to .env and fill in your values

# ============ RPC ENDPOINTS ============
BASE_RPC_URL=https://mainnet.base.org
BASE_FORK_RPC_URL=https://mainnet.base.org

# ============ PRIVATE KEYS ============
# Deployer private key (DO NOT COMMIT!)
PRIVATE_KEY=0x...

# ============ ADDRESSES ============
# Base Mainnet addresses
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
WETH_ADDRESS=0x4200000000000000000000000000000000000006

# Treasury recipients
OWNER_WALLET=0x...
BRIDGE_RESERVE=0x...
INSURANCE_FUND=0x...
REBASE_FUND=0x...

# Operations
OPERATOR_ADDRESS=0x...
BOT_ADDRESS=0x...

# ============ API KEYS ============
BASESCAN_API_KEY=your_basescan_api_key_here

# ============ ORACLE CONFIG ============
INITIAL_ETH_PRICE=2500000000  # 2500 USDC (6 decimals)
MAX_GRADIENT_BPS=1000         # ±10%

# ============ BRIDGE CONFIG ============
MIN_HEALTH_FACTOR=15000       # 150%
EMERGENCY_THRESHOLD=11000     # 110%

# ============ AMM CONFIG ============
SWAP_FEE_BPS=30              # 0.3%
INITIAL_LIQUIDITY_USDS=500000000000000000000000  # 500k USDS (18 decimals)
INITIAL_LIQUIDITY_ETHS=200000000000000000000     # 200 ETHS (18 decimals)

# ============ TREASURY CONFIG ============
OWNER_SHARE_BPS=4000         # 40%
BRIDGE_RESERVE_SHARE_BPS=3000 # 30%
INSURANCE_SHARE_BPS=2000     # 20%
REBASE_SHARE_BPS=1000        # 10%
